# local：账号、数据、文件都放本机（默认）
# cloud：连远端云服务（官方站用）
PS_MODE=local
# 本地模式数据目录，容器里默认 /app/data
PS_DATA_DIR=

# ---------- 数据面 ----------
# 默认走同源代理：容器把浏览器发往 /.cloud/** 的请求转发到下面这个已发布地址。
# 这样任何域名 / IP 都能直接使用，不受跨源预检限制。
# 想接自己的云服务应用，把这里改成你的域名；想完全直连（需对方允许你的来源），
# 把 PS_UPSTREAM 留空并填写 PS_ENDPOINT。
PS_UPSTREAM=https://pixelsong.app.workbuddy.host
PS_ENDPOINT=
# 若服务器 DNS 被污染，可把 PS_UPSTREAM 换成可达 IP，并用它指定 SNI 与 Host
PS_UPSTREAM_HOST=
# 公司网络做 TLS 拦截、Node 不认自签根证书时置 1（内网使用，公网慎用）
PS_TLS_INSECURE=

# 极验行为验证 4.0（console.geetest.com → 新建应用 → 行为验证 4.0）
# 两个都填才会启用；缺一个按未配置处理，登录仍可用但不做机验
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=

# CNKD 一证通行（OAuth 2.0 授权码 + PKCE S256）
# client_id 由 CNKD 平台审核后发放；public 应用无需 client_secret
CNKD_CLIENT_ID=
CNKD_CLIENT_SECRET=
# 必须与平台登记的回调地址逐字一致（含末尾斜杠、大小写、协议）
CNKD_REDIRECT_URI=https://pixelsong.app.workbuddy.host/api/cnkd/callback

# VirusTotal：按 SHA-256 查询已有扫描报告（不上传文件）
# 免费 key 限速 4 次/分钟，服务端已做 30 分钟缓存
VT_API_KEY=

# 本地调试端口；部署平台会自动注入 PORT，留空即可
PORT=3000
