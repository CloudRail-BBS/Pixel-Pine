# 极验行为验证 4.0（console.geetest.com → 新建应用 → 行为验证 4.0）
# 两个都填才会启用；缺一个按未配置处理，登录仍可用但不做机验
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=

# CNKD 一证通行（OAuth 2.0 授权码 + PKCE S256）
# client_id 由 CNKD 平台审核后发放；public 应用无需 client_secret
CNKD_CLIENT_ID=
CNKD_CLIENT_SECRET=
# 必须与平台登记的回调地址逐字一致（含末尾斜杠、大小写、协议）
CNKD_REDIRECT_URI=https://pixelsong.app.workbuddy.host/api/cnkd/callback

# 本地调试端口；部署平台会自动注入 PORT，留空即可
PORT=3000
