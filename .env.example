# 像素松 · 运行配置
#
# 只需要这三项。邮件、人机验证、病毒扫描、CNKD 登录全部在
# 后台「设置」里配置，账号与作品都存在本机，不依赖任何外部服务。

# 运行模式：local = 全部数据在本机（默认）；cloud = 接回 WorkBuddy 托管云服务
PS_MODE=local

# 数据目录，容器内默认 /app/data（请挂载持久化卷，否则重建容器会丢数据）
PS_DATA_DIR=

# 监听端口
PORT=3000

# 对外访问地址（可选）。反向代理没传 X-Forwarded-Host 时必填，
# sitemap、canonical 与 OAuth 回调都依赖它。
PS_PUBLIC_ORIGIN=

# 搜索引擎站点验证（可选）。从各站长平台拿到验证码后填入，会写进页面 <meta>。
PS_SEO_GOOGLE=
PS_SEO_BAIDU=
PS_SEO_BING=
